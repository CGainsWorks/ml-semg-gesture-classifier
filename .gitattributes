# Normalise line endings so a Windows checkout and a Linux CI runner agree.
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binaries: never diffed, never line-ending mangled.
*.png binary
*.jpg binary
*.gif binary
*.mp4 binary
*.zip binary
*.mat binary
*.npz binary
*.npy binary
*.pt binary
*.pth binary
*.keras binary
*.h5 binary
*.tflite binary
*.onnx binary
*.pkl binary

# Git LFS. Nothing currently tracked here needs it: the deployment artefacts
# are a few hundred kilobytes and are regenerated by `make export` rather than
# committed, and the dataset is downloaded rather than vendored. These rules
# are in place so that if a trained weight file or a demo recording is ever
# added, it goes to LFS rather than into the history.
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.keras filter=lfs diff=lfs merge=lfs -text
*.tflite filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.mat filter=lfs diff=lfs merge=lfs -text
*.bag filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Generated reports should not clutter a diff review.
analysis/**/*.png -diff

# Except the firmware's model, which is committed as an ordinary blob. It is
# 186 KiB, the firmware embeds it byte for byte and the emulator job has to
# be able to build from a plain checkout without an LFS fetch.
firmware/model/*.tflite -filter binary
firmware/vectors/*.bin binary
