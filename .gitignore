# The Ninapro archives are downloaded, never committed. `make data` fetches
# them; data/DB5_CHECKSUMS.txt records exactly which bytes were used.
data/raw/

# Everything under artifacts/ is regenerated by `make demo`: trained weights,
# the window cache and the exported binaries. The scored results those runs
# produce live in results/ instead and ARE committed, because they are the
# evidence for every number in the README and `python -m src.check_readme`
# has to be able to verify that on a fresh checkout.
artifacts/

# Figures and reports from the synthetic wiring check. `make smoke` writes
# these on every run and they are not results, so they are not committed.
# The real ones live under analysis/db5/ and experiments/results/db5/.
analysis/synthetic/
experiments/results/synthetic/
results/synthetic/
benchmarks/*_synthetic.json
benchmarks/latency_smoke.json

# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local overrides
config/local.yaml
.env
